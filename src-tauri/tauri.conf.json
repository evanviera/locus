{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Locus",
  "version": "0.1.1",
  "identifier": "com.evanviera.locus",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Locus",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2MzkyRTU5NkY5ODQzNTkKUldSWlE1aHZXUzQ1bHIxQll3QmJ0bVFuaVBRVU51TWhCcHk4a250aHVkQjNWVnRETndobzBHREwK",
      "endpoints": [
        "https://forme.md/update/locus/{{target}}/{{arch}}/{{current_version}}",
        "https://github.com/evanviera/locus/releases/latest/download/latest.json"
      ]
    }
  }
}
